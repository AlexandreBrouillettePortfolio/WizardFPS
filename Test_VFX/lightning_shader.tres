render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_9;
uniform float DistanceToTarget = 15;



void fragment() {
// Input:7
	vec4 n_out7p0 = COLOR;
	float n_out7p1 = n_out7p0.r;


	float n_out8p0;
// Remap:8
	float n_in8p1 = 0.00000;
	float n_in8p2 = 1.00000;
	float n_in8p3 = 0.00000;
	float n_in8p4 = 0.70000;
	{
		float __input_range = n_in8p2 - n_in8p1;
		float __output_range = n_in8p4 - n_in8p3;
		n_out8p0 = n_in8p3 + __output_range * ((n_out7p1 - n_in8p1) / __input_range);
	}


// Input:4
	float n_out4p0 = TIME;


// VectorOp:5
	vec2 n_in5p1 = vec2(0.00000, 0.00000);
	vec2 n_out5p0 = vec2(n_out4p0) * n_in5p1;


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out5p0 * n_in3p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);
	float n_out2p1 = n_out2p0.r;


// SmoothStep:6
	float n_in6p1 = 0.85000;
	float n_out6p0 = smoothstep(n_out8p0, n_in6p1, n_out2p1);


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, vec2(n_out6p0));


// Input:11
	vec2 n_out11p0 = UV;
	float n_out11p2 = n_out11p0.g;


// FloatParameter:12
	float n_out12p0 = DistanceToTarget;


// FloatOp:13
	float n_in13p1 = 15.00000;
	float n_out13p0 = n_out12p0 / n_in13p1;


// Compare:10
	bool n_out10p0 = n_out11p2 < n_out13p0;


	float n_out15p0;
// Switch:15
	float n_in15p2 = 0.00000;
	n_out15p0 = mix(n_in15p2, n_out6p0, float(n_out10p0));


// Output:0
	ALBEDO = vec3(n_out9p0.xyz);
	ALPHA = n_out15p0;


}
